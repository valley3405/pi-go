# 使用前填写 API Key，然后执行：source .env

# OpenAI 兼容服务（默认）
export GOAGENT_PROVIDER="deepseek"
export GOAGENT_MODEL="deepseek-flash"
export OPENAI_BASE_URL="https://api.deepseek.com/v1/"
export OPENAI_API_KEY=""

# web_search / web_fetch 使用 DeepSeek Search/Fetch 接口（按次计费），
# 默认复用上面的 OPENAI_API_KEY；也可用 DEEPSEEK_API_KEY 单独指定，
# 或用 GOAGENT_WEB_BASE_URL 覆盖接口地址（默认 https://api.deepseek.com）。
# export DEEPSEEK_API_KEY=""

# Anthropic（使用时取消注释，并注释掉上面的 OpenAI 配置）
# export GOAGENT_PROVIDER="anthropic"
# export GOAGENT_MODEL="claude-sonnet-4-5"
# export ANTHROPIC_API_KEY=""
